
:root {
  --bg: #05070b;
  --cyan: #20f6ff;
  --red: #ff3158;
  --text: #eafcff;
  --muted: #8ba2b3;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  min-height: 100dvh;
  padding: 28px 16px;
  display: grid;
  place-items: center;
  color: var(--text);
  background:
    radial-gradient(ellipse at 50% 0%, #10283b 0%, transparent 55%),
    radial-gradient(circle at 90% 85%, #260b20 0%, transparent 35%),
    var(--bg);
  font-family: ui-monospace, Consolas, monospace;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .16;
  background-image:
    linear-gradient(#20f6ff18 1px, transparent 1px),
    linear-gradient(90deg, #20f6ff18 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: linear-gradient(to bottom, black, transparent 90%);
}

.scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 5;
  opacity: .09;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0 3px,
    rgba(255,255,255,.16) 4px
  );
}

.container {
  position: relative;
  z-index: 1;
  width: min(100%, 460px);
  animation: appear .8s ease both;
}

.brand {
  text-align: center;
  font-size: clamp(20px, 5vw, 27px);
  font-weight: 900;
  letter-spacing: 4px;
  text-shadow: 0 0 18px #20f6ff55;
  animation: brandGlow 3s ease-in-out infinite alternate;
}

.brand span {
  color: var(--red);
  text-shadow: 2px 0 var(--cyan), 0 0 15px var(--red);
}

.status {
  text-align: center;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 2px;
  margin: 18px 0 28px;
}

.status i {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #65ff9c;
  border-radius: 50%;
  box-shadow: 0 0 12px #65ff9c;
  margin-right: 8px;
  animation: pulse 1.5s infinite;
}

.login-card {
  position: relative;
  padding: clamp(22px, 6vw, 34px);
  background: rgba(5, 12, 20, .94);
  border: 1px solid #20f6ff70;
  box-shadow:
    0 0 35px #20f6ff12,
    inset 0 0 30px #20f6ff06;
  clip-path: polygon(
    0 0,
    calc(100% - 18px) 0,
    100% 18px,
    100% 100%,
    18px 100%,
    0 calc(100% - 18px)
  );
  animation: cardGlow 4s ease-in-out infinite alternate;
}

.login-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 18px;
  width: 55px;
  height: 2px;
  background: var(--red);
  box-shadow: 0 0 12px var(--red);
}

.eyebrow {
  color: var(--cyan);
  font-size: 10px;
  letter-spacing: 2px;
  margin: 0 0 20px;
}

h1 {
  margin: 0;
  font-size: clamp(28px, 8vw, 38px);
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -1px;
}

h1 span {
  color: var(--cyan);
  text-shadow: 0 0 16px #20f6ff55;
}

h1 b {
  color: var(--red);
  animation: blink 1s steps(2) infinite;
}

.subtitle {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
  margin: 12px 0 28px;
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 26px;
  padding-bottom: 12px;
  border-bottom: 1px solid #ffffff16;
}

.tabs button {
  border: 1px solid #ffffff17;
  background: #ffffff04;
  color: var(--muted);
  padding: 12px 5px;
  font: inherit;
  font-size: 10px;
  letter-spacing: .5px;
  cursor: pointer;
  transition: .25s ease;
}

.tabs button.active,
.tabs button:hover {
  color: var(--cyan);
  border-color: #20f6ff80;
  background: #20f6ff0d;
  box-shadow: inset 0 -2px var(--cyan);
}

form {
  display: flex;
  flex-direction: column;
}

form > label,
#nameGroup > label {
  color: #b4c8d6;
  font-size: 10px;
  letter-spacing: 1.5px;
  margin: 16px 0 9px;
}

input[type="email"],
input[type="password"],
input[type="text"] {
  width: 100%;
  min-width: 0;
  min-height: 48px;
  padding: 13px 14px;
  border: 1px solid #ffffff22;
  border-radius: 3px;
  outline: none;
  background: #090f18;
  color: var(--text);
  font: inherit;
  font-size: 13px;
  transition: border-color .25s, box-shadow .25s;
}

input::placeholder {
  color: #536574;
}

input[type="email"]:focus,
input[type="password"]:focus,
input[type="text"]:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px #20f6ff12, 0 0 18px #20f6ff13;
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 18px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.consent input {
  accent-color: var(--cyan);
  margin-top: 4px;
  flex-shrink: 0;
}

.consent label {
  cursor: pointer;
}

a {
  color: var(--cyan);
  text-underline-offset: 3px;
}

a:hover {
  color: white;
}

.submit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  margin-top: 24px;
  padding: 0 17px;
  border: 1px solid var(--cyan);
  background: var(--cyan);
  color: #041014;
  font: inherit;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: .25s ease;
}

.submit span:last-child {
  font-size: 20px;
}

.submit:hover {
  background: transparent;
  color: var(--cyan);
  box-shadow: 0 0 24px #20f6ff25;
  transform: translateY(-2px);
}

.submit:active {
  transform: scale(.98);
}

.submit:disabled {
  opacity: .6;
  cursor: wait;
  transform: none;
}

#message {
  min-height: 18px;
  color: var(--cyan);
  font-size: 11px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.footer-text {
  padding-top: 18px;
  margin: 18px 0 0;
  border-top: 1px solid #ffffff12;
  text-align: center;
  color: #657987;
  font-size: 9px;
  line-height: 1.7;
  letter-spacing: .7px;
}

.bottom {
  text-align: center;
  margin-top: 24px;
  color: #617887;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.hidden {
  display: none !important;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}

@keyframes blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

@keyframes brandGlow {
  from { text-shadow: 0 0 8px #20f6ff22; }
  to { text-shadow: 0 0 22px #20f6ff66; }
}

@keyframes cardGlow {
  from { box-shadow: 0 0 18px #20f6ff0b; }
  to { box-shadow: 0 0 32px #20f6ff18; }
}

@media (max-width: 360px) {
  body {
    padding: 22px 11px;
  }

  .login-card {
    padding: 21px 17px;
  }

  .brand {
    letter-spacing: 2px;
  }

  .tabs button {
    font-size: 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
